# Copy to a private deployment env file; never commit the real file or secret files.
POSTGRES_DB=faultline
POSTGRES_USER=faultline
POSTGRES_PASSWORD_FILE=./secrets/postgres-password
FAULTLINE_API_TOKEN_FILE=./secrets/api-token
FAULTLINE_DATABASE_URL_FILE=./secrets/database-url

# Public-facing host must be protected by a TLS reverse proxy with user authentication.
FAULTLINE_WEB_HOST_PORT=3000
FAULTLINE_TRUSTED_HOSTS=["backend","localhost","127.0.0.1"]

# The Docker daemon endpoint must require mutual TLS. Do not mount docker.sock.
DOCKER_HOST=tcp://docker-runner.internal:2376
DOCKER_CA_FILE=./secrets/docker-ca.pem
DOCKER_CLIENT_CERT_FILE=./secrets/docker-client-cert.pem
DOCKER_CLIENT_KEY_FILE=./secrets/docker-client-key.pem

# The daemon host must see this exact absolute path for bind-mounted workspaces.
FAULTLINE_WORKSPACE_ROOT=/srv/faultline/workspaces

# Optional external resilience service (must use HTTPS outside loopback).
FORGEFIT_BASE_URL=
FORGEFIT_ALLOW_EXTERNAL_TARGETS=false
