# Local development only. Replace the development-only password before use.
ENVIRONMENT=development
DEBUG=false
PRIVATE_DEPLOYMENT=false
APP_NAME=FAULTLINE
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Compose publishes both services on localhost only.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","backend"]

POSTGRES_DB=faultline
POSTGRES_USER=faultline
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://faultline:development-only-change-me@localhost:5432/faultline
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_ECHO=false

MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_REQUESTS_PER_MINUTE=120
EXPENSIVE_RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60

# Optional. Remote ForgeFit endpoints must use HTTPS. Keep API keys in a secret file.
FORGEFIT_BASE_URL=
FORGEFIT_ALLOW_EXTERNAL_TARGETS=false
FORGEFIT_TIMEOUT_SECONDS=5
FORGEFIT_MAX_WAIT_SECONDS=300
FORGEFIT_POLL_INTERVAL_SECONDS=1
