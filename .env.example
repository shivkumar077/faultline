# FAULTLINE Backend Configuration

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=FAULTLINE
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=faultline
POSTGRES_USER=faultline
POSTGRES_PASSWORD=faultline_dev_secret
DATABASE_URL=postgresql://faultline:faultline_dev_secret@localhost:5432/faultline

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
